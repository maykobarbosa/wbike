# Variáveis da integração Vercel + Supabase (Settings → Integrations → Supabase).
# A Vercel preenche estas variáveis ao conectar o projeto ao Supabase.
# Localmente: copie para .env e use os valores do dashboard ou da integração.

# API / Auth Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Postgres — Prisma usa estas para conexão com o banco
# Migrations (db push, migrate): non-pooling, porta 5432
NEXT_SUPABASE_URL_POSTGRES_URL_NON_POOLING=

# Runtime (aplicação): pooler, porta 6543, pgbouncer
NEXT_SUPABASE_URL_POSTGRES_PRISMA_URL=

# Alternativas aceitas pelo código (se não usar os nomes acima):
# DIRECT_URL=          → usado pelo Prisma CLI quando POSTGRES_URL_NON_POOLING não existe
# DATABASE_URL=        → usado em runtime quando POSTGRES_PRISMA_URL não existe
